{
  "manifest_version": 3,
  "name": "Wren Security",
  "version": "1.3.0",
  "description": "Chặn theo dõi, dọn link bẩn (fbclid, utm…), cảnh báo link lạ, chặn web nguy hiểm, sao lưu cấu hình & cookie, ẩn 'Đã xem' trên Messenger.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Wren Security",
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "options_page": "options/options.html",
  "permissions": ["declarativeNetRequest", "storage", "activeTab"],
  "optional_permissions": ["cookies"],
  "host_permissions": ["*://*.facebook.com/*", "*://*.messenger.com/*"],
  "optional_host_permissions": ["*://*/*"],
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    {
      "matches": ["*://*.facebook.com/*", "*://*.messenger.com/*"],
      "exclude_matches": ["*://l.facebook.com/*", "*://lm.facebook.com/*", "*://l.messenger.com/*"],
      "js": ["shared/defaults.js", "content/cleaner.js", "content/linkwarn.js"],
      "run_at": "document_start",
      "all_frames": false
    },
    {
      "matches": ["*://*.facebook.com/*", "*://*.messenger.com/*"],
      "exclude_matches": ["*://l.facebook.com/*", "*://lm.facebook.com/*", "*://l.messenger.com/*"],
      "js": ["content/messenger-main.js"],
      "run_at": "document_start",
      "all_frames": false,
      "world": "MAIN"
    },
    {
      "matches": ["*://l.facebook.com/*", "*://lm.facebook.com/*", "*://l.messenger.com/*"],
      "js": ["shared/defaults.js", "content/unwrap.js"],
      "run_at": "document_start",
      "all_frames": false
    }
  ],
  "declarative_net_request": {
    "rule_resources": [
      { "id": "block_trackers", "enabled": true, "path": "rules/block_trackers.json" },
      { "id": "block_seen", "enabled": false, "path": "rules/block_seen.json" },
      { "id": "block_typing", "enabled": false, "path": "rules/block_typing.json" }
    ]
  },
  "web_accessible_resources": [
    {
      "resources": ["warning/warning.html"],
      "matches": ["<all_urls>"]
    }
  ]
}
